{
  "name": "saucedemo-e2e",
  "version": "1.0.0",
  "description": "End-to-end test suite for saucedemo.com built with Playwright and TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui-suite": "playwright test --project=chromium --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "zod": "^3.25.0"
  }
}
